# Copy to .env.local and fill in. These values are public by design (they ship in the app).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Project publishable key (sb_publishable_...). Leave empty to use the fake cloud in development.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public half of the VAPID key pair used for Web Push reminders.
VITE_VAPID_PUBLIC_KEY=
# Set to "on" once the Google provider is enabled in Supabase (Authentication > Providers > Google).
VITE_GOOGLE_SIGN_IN=
